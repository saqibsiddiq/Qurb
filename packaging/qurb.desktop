[Desktop Entry]
Type=Application
Name=Qurb
GenericName=File sync
Comment=Private cloud storage — your files, on your own devices
# The window rather than the tray: decision 0040. The tray is still installed,
# as qurb-tray, for a desktop that has one.
Exec=qurb-desktop
Icon=qurb
Terminal=false
Categories=Utility;
Keywords=sync;files;backup;p2p;
StartupNotify=false
NoDisplay=false
X-GNOME-UsesNotifications=true
