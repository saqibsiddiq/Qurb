# Rust
/target/
**/target/
*.pdb

# Spike scratch output
/experiments/**/scratch/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Android app build output. `local.properties` holds this machine's SDK path.
android/local.properties
android/.gradle/
android/build/
android/app/build/
# Copied in by scripts/android-app.sh from cargo's output, and regenerated
# every build -- committing them would mean a stale binary or stale bindings
# silently shipping.
android/app/src/main/jniLibs/
android/app/src/main/java/uniffi/

# Understand Anything knowledge-graph cache (regenerated locally by /understand)
.ua/

# Firebase, for waking sleeping devices. See
# docs/decisions/0028-waking-a-sleeping-device.md.
#
# The Android config is not a secret -- it ships inside every APK -- but it
# names one particular person's project, and a checkout carrying it would have
# strangers' phones registering against it. The service account key *is* a
# secret and must never be anywhere near a commit.
android/app/google-services.json
**/*firebase-adminsdk*.json
**/service-account*.json

# Gradle's Kotlin session directory.
android/.kotlin/
