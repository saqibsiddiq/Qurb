{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qurb",
  "version": "0.1.0",
  "identifier": "app.qurb.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Qurb",
        "visible": false,
        "width": 1120,
        "height": 760,
        "minWidth": 700,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src http://127.0.0.1:*; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Private cloud storage on your own devices",
    "longDescription": "qurb keeps your files on the devices you already own, end-to-end encrypted, and syncs them directly between those devices. Nothing is stored on anybody else's server."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwRDZGRjE5QzQzMEFFNDgKUldSSXJqREVHZi9Xa0JkUnAzbmZrSERGZjNHTVFsQlBiVlI3R3BSV2lVTHJIOWk3a1U4TFVwaUoK",
      "endpoints": [
        "https://github.com/saqibsiddiq/Qurb/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
