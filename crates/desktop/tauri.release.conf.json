{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb",
      "rpm"
    ],
    "publisher": "Qurb",
    "homepage": "https://github.com/saqibsiddiq/Qurb",
    "license": "MIT OR Apache-2.0",
    "linux": {
      "deb": {
        "section": "utils",
        "depends": [
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "files": {
          "/usr/bin/qurb": "../../target/package/release/qurb",
          "/usr/bin/qurb-tray": "../../target/package/release/qurb-tray",
          "/usr/share/icons/hicolor/scalable/apps/qurb.svg": "../../packaging/qurb.svg",
          "/usr/share/doc/qurb/server.md": "../../packaging/server/README.md"
        },
        "desktopTemplate": "../../packaging/qurb.desktop"
      },
      "rpm": {
        "depends": [
          "libappindicator-gtk3"
        ],
        "files": {
          "/usr/bin/qurb": "../../target/package/release/qurb",
          "/usr/bin/qurb-tray": "../../target/package/release/qurb-tray",
          "/usr/share/icons/hicolor/scalable/apps/qurb.svg": "../../packaging/qurb.svg",
          "/usr/share/doc/qurb/server.md": "../../packaging/server/README.md"
        },
        "desktopTemplate": "../../packaging/qurb.desktop"
      }
    }
  }
}
