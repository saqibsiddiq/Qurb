<?xml version="1.0" encoding="utf-8"?>
<!-- A row in a card (the redesign's Setting row): an icon in a small quiet
     tile, a name, one short value under it, and at the end a switch, an arrow
     or nothing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_bg"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:id="@+id/tile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/tile_small">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/text_2" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Text.Name" />

        <TextView
            android:id="@+id/value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/Text.Meta"
            android:textColor="@color/text_2"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_m"
        android:visibility="gone"
        app:thumbTint="@color/switch_thumb"
        app:trackTint="@color/switch_track" />

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="@dimen/gap_m"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="@color/text_3" />
</LinearLayout>
