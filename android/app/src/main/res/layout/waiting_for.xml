<?xml version="1.0" encoding="utf-8"?>
<!-- Joining: the number this phone shows while the other device asks whether
     to let it in (decision 0053), large, for the person to compare, and where
     to approve it, by that device's name when it says it (decision 0074).
     Setup's last step, and the page over Devices when this phone joins from
     there (Pairing draft 1, Waiting for saqib); filled by Approval.fill. A
     join cannot be called off midway, so there is no Cancel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7" />

    <!-- The other device's face, its name, the six digits boxed, and the
         question (the setup stories of 2026-11-03: "the same six digits"). -->
    <FrameLayout
        android:id="@+id/waitFace"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/waitTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:textAppearance="@style/Text.Title" />

    <LinearLayout
        android:id="@+id/waitNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/waitSays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textAppearance="@style/Text.Meta"
        android:textColor="@color/text_3" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/green"
            app:indicatorSize="14dp"
            app:trackThickness="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Waiting for it"
            android:textAppearance="@style/Text.Meta"
            android:textColor="@color/text_3" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
