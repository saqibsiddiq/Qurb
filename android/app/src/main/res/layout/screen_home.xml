<?xml version="1.0" encoding="utf-8"?>
<!-- Home: is my Qurb space okay? The state; Sync now and Send side by side;
     a line of facts; attention when something needs a decision; what is still
     waiting to reach the other devices; and the backups (the owner's items 8
     and 10, 2026-10-14, which widen direction §5's one action). What happened
     lately is the clock, a button away. Pulling down syncs. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/nav_clearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/gutter"
            android:paddingTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/qurb_mark" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Qurb"
                    android:textAppearance="@style/Text.Section" />

                <ImageView
                    android:id="@+id/activity"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="-10dp"
                    android:background="@drawable/row_bg"
                    android:contentDescription="Activity"
                    android:padding="10dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/text_2" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/mark"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/mark">

                <ImageView
                    android:id="@+id/mark_arc"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/mark_arc"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/mark_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    app:tint="@color/healthy" />
            </FrameLayout>

            <TextView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:textAppearance="@style/Text.Hero" />

            <TextView
                android:id="@+id/state_says"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/Text.Quiet" />

            <!-- The two things Home is for (the owner's item 8, 2026-10-14):
                 bring everything up to date, and send something. Equal, side
                 by side; with no device yet, one: add a device. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sync"
                    style="@style/Widget.Qurb.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="Sync now"
                    app:icon="@drawable/ic_refresh_cw"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action"
                    style="@style/Widget.Qurb.Button"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:text="Send"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <TextView
                android:id="@+id/facts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/Text.Meta" />

            <LinearLayout
                android:id="@+id/attention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- What has not reached the other devices yet (item 8). -->
            <LinearLayout
                android:id="@+id/waiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- WhatsApp and this phone's folders, kept on the computer
                 (item 10). -->
            <LinearLayout
                android:id="@+id/backups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
