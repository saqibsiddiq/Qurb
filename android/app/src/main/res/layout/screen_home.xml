<?xml version="1.0" encoding="utf-8"?>
<!-- Home, as redesigned (docs/design/redesign.md, Home draft 3): the device
     chosen here, its state in the middle of the screen as a large mark and
     two or three words, the device as a chip that chooses another, then Sync
     and Send of one size. What is still on its way shows under them, and only
     while something is. Backups and Activity are buttons at the top. Pulling
     down syncs. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/nav_clearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/gutter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/qurb_mark" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Qurb"
                    android:textAppearance="@style/Text.Title" />

                <ImageView
                    android:id="@+id/backups"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/row_bg"
                    android:contentDescription="Backups"
                    android:padding="10dp"
                    android:src="@drawable/ic_hard_drive"
                    app:tint="@color/text" />

                <ImageView
                    android:id="@+id/activity"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="-10dp"
                    android:background="@drawable/row_bg"
                    android:contentDescription="Activity"
                    android:padding="10dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/text" />
            </LinearLayout>

            <!-- Above and below the state: equal, so that it sits in the
                 middle of the screen; small, while a queue shows under it. -->
            <Space
                android:id="@+id/above"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/mark_box"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:layout_gravity="center_horizontal">

                <com.qurb.StatusMark
                    android:id="@+id/mark"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <FrameLayout
                    android:id="@+id/mark_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:textAppearance="@style/Text.Hero" />

            <!-- Two versions: the way to them, under the words. -->
            <TextView
                android:id="@+id/review"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:background="@drawable/row_bg"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="2dp"
                android:drawableTint="@color/green"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:paddingHorizontal="10dp"
                android:text="Review"
                android:textAppearance="@style/Text.Name"
                android:textColor="@color/green"
                android:visibility="gone" />

            <!-- The device chosen here; tapping it chooses another. -->
            <FrameLayout
                android:id="@+id/device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sync"
                    style="@style/Widget.Qurb.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:text="Sync"
                    android:textColor="@color/text"
                    app:backgroundTint="@color/surface"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_refresh_cw"
                    app:iconGravity="textStart"
                    app:iconTint="@color/text"
                    app:strokeColor="@color/border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/send"
                    style="@style/Widget.Qurb.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Send"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <!-- No device yet: the one thing to do. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/add"
                style="@style/Widget.Qurb.Button"
                android:layout_width="240dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:text="Add a device"
                android:visibility="gone"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_plus"
                app:iconGravity="textStart" />

            <!-- What is still on its way: shown only while something is. -->
            <LinearLayout
                android:id="@+id/waiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <Space
                android:id="@+id/below"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
