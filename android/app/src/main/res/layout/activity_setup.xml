<?xml version="1.0" encoding="utf-8"?>
<!-- Setting up, as redesigned (docs/design/redesign.md, Setup draft 1): the
     mark and one line in the middle, the two ways in at the foot; a step has
     its title, a way back, and its one action at the foot. Few words: where
     the code is shown is three icons, the digits are six boxes, the words 24
     numbered boxes. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Not clipped to its padding: the bar for a way in under way sits in
         the foot's padding, under the step's action. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/gutter"
        android:paddingVertical="24dp">

        <!-- Welcome: start here, or join the devices you have; or, with a key
             in the Google backup, use it, start again (asked first), or join
             with a code. -->
        <LinearLayout
            android:id="@+id/welcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:importantForAccessibility="no"
                android:src="@drawable/qurb_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:accessibilityHeading="true"
                android:text="Qurb"
                android:textAppearance="@style/Text.Hero" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Your files, on your own devices"
                android:textAppearance="@style/Text.Body"
                android:textColor="@color/text_2" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.3" />

            <TextView
                android:id="@+id/found"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="Your key is in your Google backup"
                android:textAppearance="@style/Text.Meta"
                android:textColor="@color/text_2"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_cloud"
                app:drawableTint="@color/text_2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start"
                style="@style/Widget.Qurb.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Start here"
                android:visibility="invisible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/other"
                style="@style/Widget.Qurb.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="I already use Qurb"
                android:visibility="invisible" />

            <!-- With a key found: joining, as I already use Qurb does. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/joinInstead"
                style="@style/Widget.Qurb.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Join with a code"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Join: where the other device shows its code, as icons; scan it,
             or type its six digits; the 24 words for somebody who has them. -->
        <LinearLayout
            android:id="@+id/joinPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/joinBack"
                style="@style/Qurb.Back"
                android:text="Back" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityHeading="true"
                android:text="Join your devices"
                android:textAppearance="@style/Text.Hero" />

            <!-- Where the code is: Qurb, then Devices, then the plus. -->
            <LinearLayout
                android:id="@+id/where"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/group_quiet"
                android:contentDescription="On your computer: Qurb, then Devices, then the plus"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="14dp" />

            <LinearLayout
                android:id="@+id/scan"
                style="@style/Qurb.BigOption"
                android:layout_marginTop="16dp">

                <FrameLayout style="@style/Qurb.BigOption.Tile">

                    <ImageView
                        style="@style/Qurb.BigOption.Icon"
                        android:src="@drawable/ic_qr_code" />
                </FrameLayout>

                <TextView
                    style="@style/Qurb.BigOption.Label"
                    android:text="Scan a code" />

                <ImageView style="@style/Qurb.BigOption.Chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/typeDigits"
                style="@style/Qurb.BigOption"
                android:layout_marginTop="12dp">

                <FrameLayout style="@style/Qurb.BigOption.Tile">

                    <ImageView
                        style="@style/Qurb.BigOption.Icon"
                        android:src="@drawable/ic_keyboard" />
                </FrameLayout>

                <TextView
                    style="@style/Qurb.BigOption.Label"
                    android:text="Type 6 digits" />

                <ImageView style="@style/Qurb.BigOption.Chevron" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/useWords"
                style="@style/Widget.Qurb.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Use 24 words" />
        </LinearLayout>

        <!-- Six digits, as six boxes. Typed into one field nobody sees, which
             brings up the number pad and takes a paste; the boxes show it. -->
        <LinearLayout
            android:id="@+id/digitsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/digitsBack"
                style="@style/Qurb.Back"
                android:text="Join" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityHeading="true"
                android:text="Type 6 digits"
                android:textAppearance="@style/Text.Hero" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">

                <EditText
                    android:id="@+id/code"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textColor="@android:color/transparent"
                    android:contentDescription="Six digits" />

                <LinearLayout
                    android:id="@+id/boxes"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="Same Wi-Fi"
                android:textAppearance="@style/Text.Meta"
                app:drawableStartCompat="@drawable/ic_wifi"
                app:drawableTint="@color/text_3" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/joinConfirm"
                style="@style/Widget.Qurb.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Join" />
        </LinearLayout>

        <!-- The 24 words, as 24 numbered boxes, three to a row. -->
        <LinearLayout
            android:id="@+id/restorePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/restoreBack"
                style="@style/Qurb.Back"
                android:text="Join" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityHeading="true"
                android:text="24 words"
                android:textAppearance="@style/Text.Hero" />

            <LinearLayout
                android:id="@+id/words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/restoreConfirm"
                style="@style/Widget.Qurb.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:text="Restore" />
        </LinearLayout>

        <!-- Joining: the number this phone shows while the other device asks
             whether to let it in (decision 0053), large, for the person to
             compare, and where to approve it, by that device's name when it
             says it (decision 0074). A join cannot be called off midway, so
             there is no Cancel. -->
        <LinearLayout
            android:id="@+id/waitPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.7" />

            <com.qurb.StatusMark
                android:id="@+id/waitMark"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/waitTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="Approve on your other device"
                android:textAppearance="@style/Text.Hero" />

            <TextView
                android:id="@+id/waitNumber"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/group_quiet"
                app:fontFamily="@font/inter_semibold"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:textColor="@color/text"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/waitSays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="It shows this number too"
                android:textAppearance="@style/Text.Meta" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="-16dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
</ScrollView>
