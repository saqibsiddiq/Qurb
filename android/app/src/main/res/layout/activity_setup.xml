<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="qurb"
            android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
            android:textColor="@color/ink"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your files stay on your own devices. They move directly between them, encrypted end to end, and are never stored on anyone else's server."
            android:textAppearance="@style/Text.Body"
            android:textColor="@color/ink_soft"
            android:layout_marginBottom="40dp" />

        <LinearLayout
            android:id="@+id/chooser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/create"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Set up Qurb here" />

            <TextView
                android:id="@+id/createSays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This phone becomes your first device. There is nothing to write down."
                android:textAppearance="@style/Text.Quiet"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/restore"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I already use Qurb" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Join the devices you already have, with the code one of them shows."
                android:textAppearance="@style/Text.Quiet"
                android:layout_marginTop="8dp" />

            <!-- Shown only when Block Store holds a key from before. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fromBackup"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Use the key from your Google backup"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Joining with a code from another device (decision 0052). -->
        <LinearLayout
            android:id="@+id/joinPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="On your computer, open Qurb, go to Devices and choose Add a device. Scan the code it shows. It brings your key with it, so there is nothing else to type."
                android:textAppearance="@style/Text.Body"
                android:textColor="@color/ink_soft"
                android:layout_marginBottom="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan the code" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Or type the code">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions|textVisiblePassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/joinConfirm"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Join" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/useWords"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Use my 24 words instead" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/restorePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="The 24 words, separated by spaces">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/phrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="flagNoPersonalizedLearning"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/restoreConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Restore"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
