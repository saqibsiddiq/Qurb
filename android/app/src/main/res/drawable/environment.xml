<?xml version="1.0" encoding="utf-8"?>
<!-- The environment behind the glass (§7): warm off-white, a breath of green,
     a cool neutral and a warm one, far too faint to read as shapes. Still:
     it is the window's background, drawn once. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><color android:color="@color/bg" /></item>
    <item>
        <shape>
            <gradient android:type="radial" android:centerX="0.0" android:centerY="0.0"
                android:gradientRadius="75%p" android:startColor="@color/env_glow" android:endColor="@color/env_glow_none" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:centerX="1.0" android:centerY="0.12"
                android:gradientRadius="60%p" android:startColor="@color/env_cool" android:endColor="@color/env_cool_none" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:centerX="0.85" android:centerY="1.0"
                android:gradientRadius="80%p" android:startColor="@color/env_warm" android:endColor="@color/env_warm_none" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:centerX="0.2" android:centerY="0.85"
                android:gradientRadius="55%p" android:startColor="@color/env_glow_low" android:endColor="@color/env_glow_none" />
        </shape>
    </item>
</layer-list>
