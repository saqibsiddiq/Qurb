<?xml version="1.0" encoding="utf-8"?>
<!-- The status mark's disc, with its resting ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="@color/mark_ring" />
        </shape>
    </item>
    <item android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/mark_fill" />
            <stroke android:width="1dp" android:color="@color/glass_edge" />
        </shape>
    </item>
</layer-list>
