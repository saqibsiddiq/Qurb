<?xml version="1.0" encoding="utf-8"?>
<!-- The tab bar: clear glass (§6) in shape and edge, but opaque, because
     nothing on Android blurs what scrolls behind a view and text must not
     show through it: at 98% it still did (consistency.md, row 29). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nav_glass" />
    <stroke android:width="1dp" android:color="@color/glass_edge" />
    <corners android:radius="26dp" />
</shape>
