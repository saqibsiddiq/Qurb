<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NoActionBar because MainActivity supplies its own MaterialToolbar.
         With the default, the window decor provides one too and the activity
         throws on launch: "This Activity already has an action bar supplied by
         the window decor." -->
    <style name="Theme.Qurb" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
    </style>

    <!-- The share sheet's screen is a dialog rather than a page. It reports one
         short outcome and gets out of the way, and framing it as a dialog keeps
         the app the person was actually using visible behind it. -->
    <style name="Theme.Qurb.Share" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <!-- The activity's label is what the share sheet puts on its button;
             as a window title it only repeats the screen's own heading in
             smaller type. -->
        <item name="android:windowNoTitle">true</item>
        <!-- Without these the dialog is sized to its text and comes out a
             narrow column, breaking one short sentence across four lines. -->
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
