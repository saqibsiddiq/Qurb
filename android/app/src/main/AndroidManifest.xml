<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sync needs the network. Nothing else is asked for: no storage
         permission, because the synced directory is this app's own private
         storage; no camera, because pairing codes are typed rather than
         scanned; no location, contacts, or anything else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      To hear other devices on the same Wi-Fi.

      Android drops multicast packets before they reach an application unless it
      holds a MulticastLock, to save power on a radio that would otherwise wake
      for every packet on the network. Without this the phone sends its beacons
      perfectly and receives nothing, which is exactly how it failed on hardware:
      the laptop could see the phone and the phone could not see the laptop.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- To scan a pairing code. Asked for only when the user taps "Scan",
         never at launch, and the app works without it: the code can always be
         typed instead. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- A long transfer, and only a long one, runs in the foreground so that
         Android does not freeze the app while a device is collecting a large
         file from it, with a notification saying how far it has got
         (decision 0050). Asked for when the first such transfer starts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:manageSpaceActivity=".ManageSpaceActivity"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Qurb">

        <!-- allowBackup is false deliberately. Android's backup would copy the
             encrypted vault to Google's servers, and the key wrapping it lives
             in the Keystore and does NOT travel - so a restored copy would be
             an unreadable store that looks like a working one. A new phone
             joins with a code from another device, or takes the key Block
             Store kept (decision 0052).

             manageSpaceActivity puts qurb's own screen where Settings shows
             "Clear data", and hasFragileUserData has uninstalling offer to
             keep the data: one tap had wiped the only copies of 18 files
             (decision 0053). -->

        <!-- Opened by Settings in place of "Clear data"; nothing else opens it. -->
        <activity
            android:name=".ManageSpaceActivity"
            android:exported="false"
            android:label="Qurb's storage" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The share sheet's way in. Exported because that is what being a
             share target means; it accepts only what another app explicitly
             hands over, and does nothing with an intent carrying no file.

             Its own task, so that dismissing it returns the person to whatever
             they were sharing from rather than dropping them into qurb. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Save to qurb"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Qurb.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Being woken when another device has something. Present only in a
             build with a google-services.json; without one the class does not
             exist and Android simply never starts it, which is the behaviour
             wanted. Not exported: only the messaging library starts it. -->
        <service
            android:name=".Wakeup"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:label="Scan a pairing code"
            android:screenOrientation="portrait" />

        <!-- Puts the synced files in the system file picker and the Files app.
             Without it everything lives in this app's private directory and
             only this app can see it, which makes a file sync product no other
             app can open. -->
        <provider
            android:name=".QurbDocumentsProvider"
            android:authorities="com.qurb.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- WorkManager's own service, declared with the type its long passes
             use; Android 14 refuses a foreground service without one. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
