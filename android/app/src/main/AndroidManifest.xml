<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sync needs the network. Nothing else is asked for: no storage
         permission, because the synced directory is this app's own private
         storage; no camera, because pairing codes are typed rather than
         scanned; no location, contacts, or anything else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- To scan a pairing code. Asked for only when the user taps "Scan",
         never at launch, and the app works without it: the code can always be
         typed instead. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Qurb">

        <!-- allowBackup is false deliberately. Android's backup would copy the
             encrypted vault to Google's servers, and the key wrapping it lives
             in the Keystore and does NOT travel - so a restored copy would be
             an unreadable store that looks like a working one. The recovery
             phrase is the supported way to move to a new device. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:label="Scan a pairing code"
            android:screenOrientation="portrait" />

        <!-- Puts the synced files in the system file picker and the Files app.
             Without it everything lives in this app's private directory and
             only this app can see it, which makes a file sync product no other
             app can open. -->
        <provider
            android:name=".QurbDocumentsProvider"
            android:authorities="com.qurb.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
